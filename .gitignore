# Build artifacts
out/
work/
repo/
*.iso
*.iso.sha256
*.pkg.tar.zst
*.pkg.tar.zst.sig

# makepkg working dirs
pkgbuilds/**/src/
pkgbuilds/**/pkg/
pkgbuilds/**/*.tar.gz
pkgbuilds/**/*.tar.xz
pkgbuilds/**/*.crate

# Generated package trees (regenerate with scripts/gen-agave-desktop.sh)
pkgbuilds/agave-desktop/payload/

# Private key material must never land in git
*.asc
*.private*

# Logs and OS noise
*.log
.DS_Store

# UTM VirtFS shared folder — install logs land here during manual testing
utm-logs/

# Testing overlay is copied into the profile airootfs only during an
# AGAVE_TESTING=1 build and removed after; ignore it so an interrupted build
# can never leak these into the committed profile.
iso/airootfs/usr/local/bin/agave-collect-logs
iso/airootfs/etc/systemd/system/agave-collect-logs.service
iso/airootfs/etc/systemd/system/multi-user.target.wants/agave-collect-logs.service
iso/airootfs/usr/local/bin/agave-logs-setup
