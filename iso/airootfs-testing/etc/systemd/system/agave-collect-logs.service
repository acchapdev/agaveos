[Unit]
Description=Agave testing — mirror install logs to the UTM VirtFS share
# Testing ISOs only (build-iso.sh AGAVE_TESTING=1); never in the final ISO.
After=multi-user.target

[Service]
Type=simple
# Invoked via bash: mkarchiso copies airootfs with --no-preserve=mode, which
# strips the exec bit, and we can't list this testing-only file in profiledef
# file_permissions (a missing file there fails the final build). 203/EXEC
# crash-loop otherwise.
ExecStart=/bin/bash /usr/local/bin/agave-collect-logs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
