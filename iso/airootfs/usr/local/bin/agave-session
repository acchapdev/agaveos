#!/usr/bin/env bash
# Live-session launcher invoked by greetd for the autologin user. Ensures Mango
# can always start — including on VMs and GPUs without a working DRI device —
# then execs it. Live ISO only.

# Explicit safe-graphics boot entry: force the software (pixman) renderer and
# keep Mesa/wlroots entirely off the GPU.
if grep -qw 'agave.safegraphics=1' /proc/cmdline 2>/dev/null; then
  export WLR_RENDERER=pixman
  export WLR_RENDERER_ALLOW_SOFTWARE=1
  export LIBGL_ALWAYS_SOFTWARE=1
  export WLR_NO_HARDWARE_CURSORS=1
# Default entry: if no rendering-capable DRI device is present (a VM without
# virtio-gpu, or hardware whose KMS driver failed to bind), wlroots would fail
# hard on the software EGL renderer and greetd would loop with no desktop. Allow
# the software fallback so the live session still reaches Mango.
elif ! ls /dev/dri/renderD* >/dev/null 2>&1; then
  export WLR_RENDERER_ALLOW_SOFTWARE=1
  export WLR_NO_HARDWARE_CURSORS=1
fi

exec mango
