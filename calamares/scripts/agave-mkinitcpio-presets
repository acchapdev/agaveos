#!/usr/bin/env bash
# Prepare the target's /boot and mkinitcpio presets before Calamares' initcpio
# job runs. Runs on the LIVE system (dontChroot: true); $1 is the target root
# mount point (${ROOT}).
#
# Two problems this fixes, both inherent to an archiso-based offline installer:
#   1. archiso strips the kernel images (vmlinuz-*) out of the squashfs, so
#      unpackfs never copies them — the target's /boot has no kernels and
#      mkinitcpio fails ("'/boot/vmlinuz-linux' must be readable"). Copy them
#      from the live archiso boot mount into the target.
#   2. The squashfs ships archiso mkinitcpio presets (PRESETS=('archiso')),
#      which are invalid on an installed system. Write stock default/fallback
#      presets for each installed kernel.
set -u

root="${1:-}"
log() { printf 'agave-mkinitcpio: %s\n' "$*"; }

[ -n "$root" ] && [ -d "$root" ] || { log "no target root given"; exit 1; }

# --- copy kernel images from the live medium into the target ----------------
# The live system mounts the ISO here; the kernels live outside the squashfs.
bootsrc="/run/archiso/bootmnt/agave/boot/x86_64"
if [ -d "$bootsrc" ]; then
  mkdir -p "$root/boot"
  for k in "$bootsrc"/vmlinuz-*; do
    [ -f "$k" ] || continue
    install -Dm644 "$k" "$root/boot/$(basename "$k")"
    log "installed $(basename "$k") into target /boot"
  done
else
  log "warning: live archiso boot dir not found ($bootsrc)"
fi

# --- write stock mkinitcpio presets for every installed kernel --------------
rm -f "$root/etc/mkinitcpio.conf.d/archiso.conf"
for kver_dir in "$root"/usr/lib/modules/*/; do
  [ -d "$kver_dir" ] || continue
  pkgbase_file="${kver_dir}pkgbase"
  [ -f "$pkgbase_file" ] || continue
  kernel=$(cat "$pkgbase_file")
  cat > "$root/etc/mkinitcpio.d/${kernel}.preset" <<EOF
# mkinitcpio preset file for the '${kernel}' package (Agave install)
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-${kernel}"

PRESETS=('default' 'fallback')

default_image="/boot/initramfs-${kernel}.img"

fallback_image="/boot/initramfs-${kernel}-fallback.img"
fallback_options="-S autodetect"
EOF
  log "wrote stock preset for ${kernel}"
done

log "done"
